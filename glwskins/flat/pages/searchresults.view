#import "skin://theme.view"
#import "skin://styles/style_grid.view"

widget(container_z, {

  widget(list_y, {
    id: "scrollable";

    $view.width = getWidth();

    clipOffsetTop: 3em;
    scrollThresholdTop: 5em;

    scrollThresholdBottom: $ui.universeBottomHeight + 2em;
    clipOffsetBottom: $ui.universeBottomHeight;
    clipAlpha: 0.2;
    clipBlur: 1;
    spacing: 1em;
    cloner($self.model.nodes, container_y, {

      widget(label, {
        padding: [1em, 0];
        caption: fmt('%s <font size="2" color="#aaaaaa">- %s',
                     $self.metadata.title,
                     fmt(_pl("%d hits", "%d hit", $self.entires), $self.entries));
        size: 1.5em;
      });

      widget(container_x, {
        padding: [2em, 0];
        spacing: $view.width / 30;

        cloner(propWindow($self.nodes, 0, 3), loader, {
          width: $view.width / 6;
          alt: "skin://items/rect/default.view";
          source: "skin://items/rect/" + $self.type + ".view";
        });

        widget(container_z, {
          hidden: $self.entries < 4;
          width: $view.width / 6;
          GridItemBevel();
          GridItemHighlight();

          focusable: true;
          onEvent(activate, navOpen($self.url));

          widget(container_y, {
            align: bottom;

            widget(container_z, {

              widget(quad, {
                color: 0;
                alpha: 0.5;
              });

              widget(container_y, {
                padding: [0.25em, 0.25em];
                widget(label, {
                  
                  caption: _("Show more");
                  align: center;
                });
              });
            });
          });
        });
      });
    });
  });

  ScrollBar("scrollable", 3em, $ui.universeBottomHeight);

  // Informational empty state when no media extensions or search hits exist
  widget(container_y, {
    hidden: count($self.model.nodes) > 0 || $self.model.loading > 0;
    space(1);

    widget(container_y, {
      align: center;
      width: select($ui.aspect > 1, $ui.width * 0.65, $ui.width - 4em);
      spacing: 1.2em;

      widget(icon, {
        align: center;
        size: 4em;
        source: "skin://icons/ic_search_48px.svg";
        alpha: 0.35;
      });

      widget(label, {
        align: center;
        caption: _("No Search Results");
        size: 1.6em;
        font: "skin://fonts/RobotoCondensed-Bold.ttf";
        shadow: true;
      });

      widget(label, {
        filterConstraintX: true;
        align: center;
        size: 1.1em;
        color: 0.8;
        shadow: true;
        maxlines: 8;
        caption: _("Universal Search queries installed online media extensions and plugins.\n\nNotice: It does not index or search local files on USB drives or internal HDD. To browse local files, please use the File Manager on the Home screen.");
      });
    });

    space(1);
  });

  widget(container_y, {
    align: top;
    PageHeader($self.model.metadata.title);
  });

});
