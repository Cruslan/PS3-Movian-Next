#import "skin://theme.view"

widget(container_y, {

  widget(container_x, {
    height: 3em;
    BackButton();
  });


  widget(container_x, {
    align: center;
    spacing: 1em;

    widget(icon, {
      size: 3em;
      source: "skin://icons/movian.svg";
    });
    widget(label, {
      caption: $core.app.name;
      size: 3em;
    });
  });

  widget(label, {
    caption: $core.app.version;
    alpha: 0.5;
    align: center;
  });

  widget(dummy, {
    height: 1.5em;
  });

  widget(label, {
    caption: "Original Creation & Architecture:";
    alpha: 0.8;
    align: center;
  });

  widget(label, {
    caption: "Andreas Öman (Lonelycoder AB)";
    alpha: 0.6;
    align: center;
  });

  widget(label, {
    caption: $core.app.copyright;
    alpha: 0.5;
    align: center;
  });

  widget(dummy, {
    height: 1.2em;
  });

  widget(label, {
    caption: "PlayStation 3 Modernization & PSL1GHT v2 Port:";
    alpha: 0.8;
    align: center;
  });

  widget(label, {
    caption: "Ported to modern PSL1GHT v2 SDK & Toolchain by Cruslan";
    alpha: 0.6;
    align: center;
  });

  widget(label, {
    caption: "Hardware SPU Cell VDEC Acceleration & RSX 60 FPS Engine";
    alpha: 0.6;
    align: center;
  });

  widget(dummy, {
    height: 1.2em;
  });

  widget(label, {
    caption: "Original Project: https://movian.tv";
    alpha: 0.5;
    align: center;
  });

  widget(label, {
    caption: "PlayStation 3 Open-Source Homebrew Ecosystem";
    alpha: 0.5;
    align: center;
  });


});
