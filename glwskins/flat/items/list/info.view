widget(container_x, {
  style: "ListItem";

  widget(icon, {
    autohide: true;
    source: $self.metadata.icon ?? $self.image;
    style: "ListItemIcon";
    color: [1.0, 0.35, 0.35];
  });

  widget(label, {
    filterConstraintX: true;
    caption: $self.description;
    maxlines: 16;
    color: 0.95;
  });
});
